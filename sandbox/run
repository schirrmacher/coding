#!/usr/bin/env bash
# Run commands as the invoking user inside the sandbox. See README.md.

set -euo pipefail

# Resolve the installed symlink before locating config and scripts.
SANDBOX_ROOT=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)
CONFIG="$SANDBOX_ROOT"
source "$SANDBOX_ROOT/src/read_definitions.sh"
PROXY_CONFIG=/usr/local/lib/sandbox/apps.json
PROXY_DIR=/usr/local/lib/sandbox

source "${SANDBOX_ROOT}/src/resolve_directories.sh"
source "${SANDBOX_ROOT}/src/build_mounts.sh"
source "${SANDBOX_ROOT}/src/run_payload.sh"
source "${SANDBOX_ROOT}/src/show_status.sh"

main() {
	read_config || exit 1
	APP=""

	DIRECTORY_ARGS=()
	ENV_ARGS=()
	CMD=()

	OFFLINE=0
	MODE=run
	if [[ ${1:-} =~ ^(up|down|status)$ ]]; then
		MODE=$1
		shift
	fi

	parse_args "$@"

	if [[ $MODE == run && -z $APP ]]; then
		echo "choose an app with --app NAME or use its installed wrapper" >&2
		exit 1
	fi

	if [[ $EUID -ne 0 || -z ${SUDO_UID:-} ]]; then
		echo "sandbox must be run under sudo; inside the sandbox you are yourself" >&2
		usage
	fi

	[[ $MODE != run || $APP =~ ^[a-z][a-z0-9-]*$ ]] || {
		echo "invalid app name: $APP" >&2
		exit 1
	}

	if [[ $MODE != run ]]; then
		"cmd_$MODE"
		exit
	fi

	run_payload
}

cmd_up() {
	"$SANDBOX_ROOT/up" "$PWD"
	if systemctl is-active --quiet sandbox-proxy.service 2>/dev/null; then
		echo "proxy: active (pid $(systemctl show -p MainPID --value sandbox-proxy.service))"
		return
	fi
	echo "proxy: no systemd unit; running in the foreground (Ctrl-C stops it)" >&2
	exec python3 "$PROXY_DIR/proxy.py" --apps-json "$PROXY_CONFIG"
}

cmd_down() {
	if ! systemctl is-active --quiet sandbox-proxy.service 2>/dev/null; then
		pkill -f "$PROXY_DIR/proxy.py" 2>/dev/null || true
	fi
	"$SANDBOX_ROOT/down"
}

parse_args() {
	while [[ $# -gt 0 ]]; do
		case $1 in
		--offline)
			OFFLINE=1
			shift
			;;
		--app)
			[[ $# -ge 2 ]] || usage
			APP=$2
			shift 2
			;;
		--app=*)
			APP=${1#*=}
			shift
			;;
		--directory)
			[[ $# -ge 2 ]] || usage
			DIRECTORY_ARGS+=("$2")
			shift 2
			;;
		--directory=*)
			DIRECTORY_ARGS+=("${1#*=}")
			shift
			;;
		--env)
			[[ $# -ge 2 ]] || usage
			add_env "$2"
			shift 2
			;;
		--env=*)
			add_env "${1#*=}"
			shift
			;;
		*)
			# Everything after the command is passed verbatim.
			CMD=("$@")
			return
			;;
		esac
	done
}

add_env() {
	local name=${1%%=*} value
	[[ $name =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || usage
	if [[ $1 == *=* ]]; then
		value=${1#*=}
	else
		value=${!name-}
	fi
	ENV_ARGS+=(--setenv "$name" "$value")
}

usage() {
	echo "usage: sudo sandbox --app NAME [--offline] [--directory DIR] [--env VAR[=VAL]]... [CMD [ARGS...]]" >&2
	echo "       sudo sandbox {up|down|status}" >&2
	exit 1
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
