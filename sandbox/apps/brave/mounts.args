# Hide personal files before exposing this app's explicit writable folders.
--tmpfs
${HOME}

--bind
${HOME}/.local/share/sandbox/brave
${HOME}/.local/share/sandbox/brave

--bind
${HOME}/Downloads
${HOME}/Downloads

--bind
${HOME}/dev
${HOME}/dev

--tmpfs
/run/user/${UID}

--setenv
XDG_CACHE_HOME
${HOME}/.local/share/sandbox/brave/cache

# Only display sockets and GPU devices are shared with the desktop session.
--setenv
DISPLAY
${DISPLAY}
--setenv
WAYLAND_DISPLAY
${WAYLAND_DISPLAY}
--setenv
XAUTHORITY
${XAUTHORITY}
--setenv
XDG_RUNTIME_DIR
${XDG_RUNTIME_DIR}
--ro-bind-try
${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}
${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}
--ro-bind-try
${XAUTHORITY}
${XAUTHORITY}
--bind-try
/tmp/.X11-unix
/tmp/.X11-unix
--dev-bind-try
/dev/dri
/dev/dri
