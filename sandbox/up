#!/usr/bin/env bash
# Install host confinement and start the proxy. See README.md.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
CONFIG="$SCRIPT_DIR"
PROXY_DIR=/usr/local/lib/sandbox
source "$SCRIPT_DIR/src/read_definitions.sh"
source "$SCRIPT_DIR/src/render_apparmor.sh"

source "$SCRIPT_DIR/src/configure_network.sh"
source "$SCRIPT_DIR/src/install_apparmor_profiles.sh"
source "$SCRIPT_DIR/src/install_services.sh"

prepare_app_state() {
	[[ ${CONFIG_SOURCE:-} == "$CONFIG" ]] || read_config || return 1
	config_query -e 'any(.apps[]; (.dir.state // [] | length) > 0)' >/dev/null || return 0
	local home
	local uid=${SUDO_UID:-$UID} gid=${SUDO_GID:-$(id -g)}
	home=$(getent passwd "$uid" | cut -d: -f6)
	setpriv --reuid="$uid" --regid="$gid" --init-groups --reset-env \
		python3 "$SCRIPT_DIR/src/create_app_state.py" "$home" <<< "$CONFIG_JSON"
}

validate_app_directories() {
	local app paths path
	for app in "${APPS[@]}"; do
		paths=$(app_writable_directories "$app" && app_readable_directories "$app") || return 1
		while IFS= read -r path; do
			[[ -z $path || -e $path ]] || die "app '$app': required bind source missing: $path; run applications/install $app if application setup is needed"
		done <<< "$paths"
	done
}

main() {
	[[ $EUID -eq 0 ]] || {
		echo "sandbox up must run as root: sudo $0" >&2
		usage
	}

	DEFAULT_PROJECT_DIRECTORY=$(realpath "${1:-$(dirname "$SCRIPT_DIR")}")

    require_host_commands
    load_config
	[[ ${#APPS[@]} -gt 0 ]] || die "$CONFIG declares no apps"

	echo "==> apps: ${APPS[*]}"

	NS_SUMMARY=""
	index=0
	for app in "${APPS[@]}"; do
		namespace_ip=$(create_app_network "$app" "$index")
		NS_SUMMARY+="${NS_SUMMARY:+, }$app $namespace_ip"
		index=$((index + 1))
	done
	echo "==> netns: $NS_SUMMARY"

	install_firewall
	install_apparmor
	install_proxy
	install_sudoers

	BASE="sudo sandbox"
	[[ -e /usr/local/bin/sandbox ]] || BASE="sudo $DEFAULT_PROJECT_DIRECTORY/sandbox/run"

	echo
	echo "Sandbox ready. Shell: $BASE --app NAME bash"
	echo "   Status: $BASE status"
	echo "   Test:   $BASE --app NAME bash $DEFAULT_PROJECT_DIRECTORY/sandbox/tests/boundary/test_boundary.sh"
}

load_config() {
	validate_config
	SUBNET=$(config_query -r '.net.subnet')
	POOL_BASE=${SUBNET%.*}
	POOL_PREFIX=${SUBNET#*/}
	POOL_CIDR=$SUBNET
	POOL_CAPACITY=$(( (1 << (32 - POOL_PREFIX)) / 4 ))
	SNI_PORT=$(config_query -r '.proxy.sni_port')
	DNS_PORT=$(config_query -r '.proxy.dns_port')
	mapfile -t APPS < <(config_query -r '.apps[].name')
	[[ ${#APPS[@]} -le $POOL_CAPACITY ]] \
		|| die "$CONFIG: $POOL_CAPACITY apps fit in $POOL_CIDR (4 addresses each); found ${#APPS[@]}"

    if [[ -r $PROXY_DIR/apps.json ]] && ! jq -e --arg fingerprint "$(config_query -r '.policy_fingerprint')" '.policy_fingerprint == $fingerprint' "$PROXY_DIR/apps.json" >/dev/null; then
        local namespace
        while read -r namespace _; do
            [[ $namespace == sandbox-* ]] || continue
            [[ -z $(ip netns pids "$namespace") ]] || die "close sandbox applications before replacing changed policy: $namespace is in use"
        done < <(ip netns list)
    fi
	prepare_app_state
	validate_app_directories
}

require_host_commands() {
    local command
    for command in python3 jq ip nft setpriv bwrap sysctl; do
        command -v "$command" >/dev/null || die "missing prerequisite: $command"
    done
    if config_query -e 'any(.apps[]; .network == "web")' >/dev/null; then
        command -v iptables >/dev/null || die "missing prerequisite for web networking: iptables"
    fi
}

die() {
	echo "$1" >&2
	exit 1
}

usage() {
	echo "usage: sudo sandbox/up [project-directory]" >&2
	exit 1
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
