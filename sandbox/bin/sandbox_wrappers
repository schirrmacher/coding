#!/usr/bin/env bash
# Generate managed PATH wrappers and desktop entries. See ../README.md.

set -euo pipefail

SANDBOX_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
CONFIG="$SANDBOX_ROOT/sandbox.toml"
source "$SANDBOX_ROOT/lib/query_config.sh"
LAUNCHER="$SANDBOX_ROOT/bin/sandbox"
BIN_DIR="$HOME/.local/bin"
DESKTOP_DIR="$HOME/.local/share/applications"
MARKER="sandbox-managed"
BACKUP_DIR="$HOME/.local/share/sandbox/original-launchers"
DESKTOP_BACKUP_DIR="$HOME/.local/share/sandbox/original-desktop-entries"
SYSTEM_DESKTOP_DIR=/usr/share/applications

source "${SANDBOX_ROOT}/lib/install/desktop.sh"
source "${SANDBOX_ROOT}/lib/install/files.sh"
source "${SANDBOX_ROOT}/lib/install/prepare.sh"

main() {
	read_config || exit 1
	[[ -f $CONFIG ]] || {
		echo "config not found: $CONFIG" >&2
		exit 1
	}
	command -v jq >/dev/null || {
		echo "jq is required to parse $CONFIG" >&2
		exit 1
	}
	validate_launcher_config || exit 1

	prepare_installation
	generate_launchers
	remove_stale_launchers
	install_host_integration
}

generate_launchers() {
	mapfile -t CMD_APPS < <(config_query -r '.apps[] | select(.cmd != null) | .name')
	mapfile -t GUI_APPS < <(policy_query desktop-apps)

	echo "==> sandbox wrappers ($CONFIG)"
	for app in "${CMD_APPS[@]}"; do
		write_wrapper "$app"
	done
	for app in "${GUI_APPS[@]}"; do
		write_desktop_entry "$app"
	done
}

remove_stale_launchers() {
	mapfile -t MANAGED_FILES < <(config_query -r '.apps[] | select(.cmd != null) | .wrapper_name // .name')
	remove_stale "$BIN_DIR" ''
	mapfile -t MANAGED_FILES < <(desktop_filenames)
	remove_stale "$DESKTOP_DIR" '.desktop'
}

install_host_integration() {
	# sudo secure_path excludes ~/.local/bin; install the global launcher link.
	SUDO_FRONT=()
	[[ $EUID -eq 0 ]] || SUDO_FRONT=(sudo)
	if [[ -L /usr/local/bin/sandbox && $(realpath /usr/local/bin/sandbox) == "$LAUNCHER" ]]; then
		echo "  /usr/local/bin/sandbox (already installed)"
	elif "${SUDO_FRONT[@]}" ln -sfn "$LAUNCHER" /usr/local/bin/sandbox; then
		echo "  /usr/local/bin/sandbox"
	else
		echo "  could not create /usr/local/bin/sandbox; run by hand:" >&2
		echo "    sudo ln -sfn $LAUNCHER /usr/local/bin/sandbox" >&2
	fi

	if command -v update-desktop-database >/dev/null; then
		update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
	fi
}

write_wrapper() {
	local app=$1
	local wrapper_name
	wrapper_name=$(config_query -r --arg app "$app" 'first(.apps[] | select(.name == $app)) | .wrapper_name // .name')
	[[ $wrapper_name =~ ^[a-z][a-z0-9-]*$ ]] || return 1
	local -a command=()
	mapfile -t command < <(app_cmd "$app")
	local path="$BIN_DIR/$wrapper_name"
    local executable
    executable=$(policy_query executable "$app") || return 1
	preserve_launcher "$path" "$executable" || return 1
	install_from_stdin "$path" executable <<EOF
#!/usr/bin/env bash
# $MARKER wrapper for app "$app" — regenerate with make install
exec sudo -n $(quoted_cmd "$LAUNCHER" --app "$app") $(quoted_cmd "${command[@]}")"\$@"
EOF
	echo "  $path"
}

app_cmd() {
	config_query -r --arg app "$1" 'first(.apps[] | select(.name == $app) | .cmd)[]'
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
